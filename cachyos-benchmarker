# traps (ctrl-c)
killproc() {
	echo -e "\n**** Received SIGINT, aborting! ****\n"
	kill -- -$$ && exit 2
}

exitproc() {
	echo -e "\n-> Removing temporary files..."
	rm -f "$WORKDIR"/run* "$WORKDIR"/stressC "$WORKDIR"/schbench_raw \
	      "$WORKDIR"/*.txt "$WORKDIR"/*.jpg "$WORKDIR"/*.ppm
	rm -f "$ASSETDIR"/*.part
	rm -f "$LOCKFILE"

	if [[ "$CLEANUP" == "true" ]]; then
		echo -e "-> Cleaning up downloaded archives and extracted directories..."
		rm -f "$ASSETDIR"/firefox102.tar.xz "$ASSETDIR"/*.zst "$ASSETDIR"/*.7z \
		      "$ASSETDIR"/ffmpeg.tar.xz "$ASSETDIR"/namd.tar.gz "$ASSETDIR"/namd-example.tar.gz \
		      "$ASSETDIR"/linux-$KERNVER.tar.xz "$ASSETDIR"/y-cruncher.tar.xz
		rm -rf "$ASSETDIR/ffmpeg-$FFMPEGVER" "$ASSETDIR/.ffmpeg-${FFMPEGVER}.done" \
		       "$ASSETDIR/namd/NAMD_${NAMDVER}_Linux-x86_64-multicore" "$ASSETDIR/namd/apoa1" "$ASSETDIR/.namd-${NAMDVER}.done" \
		       "$ASSETDIR/linux-$KERNVER" "$ASSETDIR/.linux-${KERNVER}.done" \
		       "$ASSETDIR/y-cruncher v$YCRUNCHER_VER-static" "$ASSETDIR/.yc-${YCRUNCHER_VER}.done" \
		       "$ASSETDIR/firefox102.tar" "$ASSETDIR/.firefox.done" \
		       "$ASSETDIR/bosphorus_hd.y4m" "$ASSETDIR/.video.done" \
		       "$ASSETDIR/.blend.done"
		# The Blender model is a downloaded file only when the repository does
		# not ship one; the vendored copy must survive a cleanup.
		if [[ ! -f "$SCRIPT_ASSETS/bmw_cpu_mod.blend" ]]; then
			rm -f "$ASSETDIR/bmw_cpu_mod.blend"
		fi
	fi
	echo -e "${TB}Bye!${TN}\n"
}

