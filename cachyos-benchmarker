# check if the active scheduler is still running and hasn't crashed/exited
check_scheduler_integrity() {
	if [[ "$SCX" != "none" ]]; then
		if [ -f "/sys/kernel/sched_ext/root/ops" ]; then
			local CURRENT_OPS
			CURRENT_OPS=$(cat "/sys/kernel/sched_ext/root/ops" 2>/dev/null || true)
			if [ -z "$CURRENT_OPS" ]; then
				return 1
			fi
			local CURRENT_SCX
			CURRENT_SCX=$(echo "$CURRENT_OPS" | awk -F'[[:digit:]]' '{print $1}' | sed -rn 's/^(.*)_$/\1/p')
			[[ -z "$CURRENT_SCX" ]] && CURRENT_SCX="$CURRENT_OPS"
			if [[ "$CURRENT_SCX" != "$SCX" ]]; then
				return 1
			fi
		else
			return 1
		fi
	fi
	return 0
}

# animation
animate() {
	local s='-+' ; local i=0
	while kill -0 "$PID" &>/dev/null
	do
		if ! check_scheduler_integrity; then
			printf "\n${FARBE1}${TB}**** CRITICAL: Scheduler crashed or exited during ${TNAMES[$1]}! ****${TN}\n"
			kill -9 "$PID" 2>/dev/null || true
			echo -e "${TNAMES[$1]}: FAILED (Scheduler crashed)" >> "$LOGFILE"
			echo -e "\nSCX Scheduler: ${SCX} (CRASHED during ${TNAMES[$1]})" >> "$LOGFILE"
			exit 9
		fi
		i=$(( (i+1) %2 ))
		printf "\b${s:$i:1}"
		sleep 1
	done
	# The child's exit status decides the run result: a non-zero status is
	# recorded as a failed benchmark and propagated to the || exit 8 chain.
	wait "$PID"
	local rc=$?
	if (( rc != 0 )); then
		printf "\b "
		echo -e "* ${TNAMES[$1]}:\t\tFAILED"
		echo -e "${TNAMES[$1]}: FAILED (exit code $rc)" >> "$LOGFILE"
		return $rc
	fi
	printf "\b " ; cat "$RESFILE"
	echo -e "${TNAMES[$1]}: $(cat "$RESFILE")" >> "$LOGFILE"
	return 0
}

# Download to a temporary name and only rename into place once the archive has
# been validated. A failed transfer therefore leaves no file behind for a later
# run to mistake for a valid cache entry, and a retry is always a clean retry.
# This mirrors the kernel's atomic state transitions: never expose a
# partially-constructed object under its final name.
ensure_archive() {
	local file="$1"
	local description="$2"
	local url="$3"
	local sha="$4"
	shift 4
	local part="${file}.part"

	if [[ -f "$file" ]]; then
		# A cached archive is accepted only when both the probe and the pinned
		# hash pass; anything else is discarded and fetched again.
		local cached_ok=true
		"$@" "$file" &>/dev/null || cached_ok=false
		if [[ -n "$sha" ]]; then
			echo "$sha  $file" | sha256sum -c - &>/dev/null || cached_ok=false
		fi
		if [[ "$cached_ok" != "true" ]]; then
			echo "--> Cached ${description} archive is invalid, re-downloading..."
			rm -f "$file"
		fi
	fi

	if [[ ! -f "$file" ]]; then
		local attempt=1
		while (( attempt <= 2 )); do
			echo "--> Downloading ${description} archive (attempt ${attempt}/2)..."
			rm -f "$part"
			wget -c --timeout=60 --tries=3 --show-progress -qO "$part" "$url"
			local wget_rc=$?
			if (( wget_rc != 0 )); then
				echo "ERROR: Failed to download ${description} archive from ${url} (wget exit code ${wget_rc})"
				rm -f "$part"
				attempt=$((attempt + 1))
				continue
			fi
			if [[ -n "$sha" ]] && ! echo "$sha  $part" | sha256sum -c - &>/dev/null; then
				echo "ERROR: ${description} archive from ${url} failed its SHA-256 checksum"
				rm -f "$part"
				attempt=$((attempt + 1))
				continue
			fi
			if ! "$@" "$part" &>/dev/null; then
				echo "ERROR: ${description} archive from ${url} failed archive validation"
				rm -f "$part"
				attempt=$((attempt + 1))
				continue
			fi
			mv -Tf "$part" "$file"
			if (( $? != 0 )); then
				echo "ERROR: Failed to move ${description} archive into place"
				rm -f "$part"
				exit 3
			fi
			break
		done
		if (( attempt > 2 )); then
			echo "ERROR: Giving up on ${description} archive after repeated failures"
			exit 3
		fi
	fi
}

# tests
runstress() {
	local RESFILE="$WORKDIR/runstress"
	/usr/bin/time -f %e -o "$RESFILE" stress-ng -q --job "$WORKDIR/stressC" &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[0]}:\t\t"
	animate 0 && return 0 || return 99
}

runffm() {
	cd "$ASSETDIR/ffmpeg-$FFMPEGVER" || exit 4
	local RESFILE="$WORKDIR/runffm"
	/usr/bin/time -f %e -o "$RESFILE" make -s -j${CPUCORES} &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[1]}:\t\t\t"
	animate 1 && return 0 || return 99
}

runx265() {
	local RESFILE="$WORKDIR/runx265"
	/usr/bin/time -f %e -o "$RESFILE" x265 -p slow -b 6 -o /dev/null \
	  --no-progress --log-level none --input "$ASSETDIR/bosphorus_hd.y4m" &
	local PID=$!
	echo -n -e "* ${TNAMES[2]}:\t\t\t"
	animate 2 && return 0 || return 99
}

runargon() {
	local RESFILE="$WORKDIR/runargon"
	/usr/bin/time -f %e -o "$RESFILE" argon2 BenchieSalt -id -t 20 -m 21 \
	  -p "$CPUCORES" &>/dev/null <<< $(head -c 64 /dev/urandom) &
	local PID=$!
	echo -n -e "* ${TNAMES[3]}:\t\t\t"
	animate 3 && return 0 || return 99
}

runperf_sch() {
	local RESFILE="$WORKDIR/runperfs"
	perf bench -f simple sched messaging -t -g 24 -l 6000 1> "$RESFILE" &
	local PID=$!
	echo -n -e "* ${TNAMES[4]}:\t\t"
	animate 4 && return 0 || return 99
}

runperf_mem() {
	local RESFILE="$WORKDIR/runperfm"
	/usr/bin/time -f %e -o "$RESFILE" perf bench -f simple mem memcpy --nr_loops 100 \
	  --size 2GB -f default &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[5]}:\t\t\t\t"
	animate 5 && return 0 || return 99
}

runprime() {
	local RESFILE="$WORKDIR/runprime"
	/usr/bin/time -f%e -o "$RESFILE" primesieve 666000000000 --no-status | awk -F ': ' \
	  '/Seconds/{print $2}' 1> "$RESFILE" &
	local PID=$!
	echo -n -e "* ${TNAMES[6]}:\t\t"
	animate 6 && return 0 || return 99
}

runnamd() {
	cd "$ASSETDIR/namd/NAMD_3.0b6_Linux-x86_64-multicore" || exit 4
	local RESFILE="$WORKDIR/runnamd"
	rm -f ../apoa1/FFTW*.txt
	/usr/bin/time -f%e -o "$RESFILE" ./namd3 +p${CPUCORES} +setcpuaffinity \
	  ../apoa1/apoa1.namd &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[7]}:\t\t\t"
	animate 7 && return 0 || return 99
}

runblend() {
	local RESFILE="$WORKDIR/runblend"
	export BLENDER_USER_CONFIG="$WORKDIR"
	local BLEND_SRC
	if [[ -f "$SCRIPT_ASSETS/bmw_cpu_mod.blend" ]]; then
		BLEND_SRC="$SCRIPT_ASSETS/bmw_cpu_mod.blend"
		echo "$BLENDER_SHA  $BLEND_SRC" | sha256sum -c - &>/dev/null || \
		  { echo "ERROR: Vendored Blender model failed its SHA-256 checksum"; exit 4; }
	else
		if [[ ! -f "$ASSETDIR/.blend.done" ]]; then
			rm -f "$ASSETDIR/bmw_cpu_mod.blend"
			ensure_archive "$ASSETDIR/bmw_cpu_mod.blend" "Blender BMW model" \
			  "https://gitlab.com/torvic9/mini-benchmarker/-/raw/master/bmw_cpu_mod.blend" \
			  "$BLENDER_SHA" true
			: > "$ASSETDIR/.blend.done"
		fi
		BLEND_SRC="$ASSETDIR/bmw_cpu_mod.blend"
	fi
	/usr/bin/time -f %e -o "$RESFILE" blender -b "$BLEND_SRC" \
	  -o "$WORKDIR/blenderbmw.jpg" -f 1 --verbose 0 -t ${CPUCORES} &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[8]}:\t\t\t"
	animate 8 && return 0 || return 99
}

runxz() {
	local RESFILE="$WORKDIR/runxz"
	/usr/bin/time -f %e -o "$RESFILE" xz -z -k -T${CPUCORES} -Qqq \
	  -f "$ASSETDIR/firefox102.tar" &
	local PID=$!
	echo -n -e "* ${TNAMES[9]}:\t\t\t"
	animate 9 && return 0 || return 99
}

runkern() {
	cd "$ASSETDIR/linux-$KERNVER" || exit 4
	local RESFILE="$WORKDIR/runkern"
	/usr/bin/time -f %e -o "$RESFILE" make KCFLAGS='-Wno-error' -sj$CPUCORES vmlinux &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[10]}:\t\t\t"
	animate 10 && return 0 || return 99
}

runyc() {
	cd "$ASSETDIR/y-cruncher v$YCRUNCHER_VER-static" || exit 4
	rm -f "Pi*.txt"
	local RESFILE="$WORKDIR/runyc"
	/usr/bin/time -f%e -o "$RESFILE" ./y-cruncher bench 1b -od:0 \
	  -o "$WORKDIR" &>/dev/null &
	local PID=$!
	echo -n -e "* ${TNAMES[11]}:\t\t\t"
	animate 11 && return 0 || return 99
}

runschbench() {
	local RESFILE="$WORKDIR/runschbench"
	schbench -m 2 -r 30 2>&1 | tee "$WORKDIR/schbench_raw" | \
	  grep -oP '99\.0th:\s*\K\d+' | head -1 | \
	  awk '{printf "%.2f\n", $1}' > "$RESFILE" &
	local PID=$!
	echo -n -e "* ${TNAMES[12]}:\t\t"
	animate 12 && return 0 || return 99
}

runrps() {
	local RESFILE="$WORKDIR/runrps"
	if [[ -f "$WORKDIR/schbench_raw" ]]; then
		grep -oP 'average rps: \K[\d.]+' "$WORKDIR/schbench_raw" | \
		  awk '{printf "%.2f\n", $1}' > "$RESFILE"
	fi
	echo -n -e "* schbench avg rps:\t\t"
	cat "$RESFILE" 2>/dev/null || echo "N/A"
	return 0
}

runcyclictest() {
	local RESFILE="$WORKDIR/runcyclictest"
	cyclictest -D 30 -t -i 1000 -d 0 -q -m --policy=other 2>/dev/null | \
	  grep '^T:' | sed 's/.*Max:[[:space:]]*//' | sort -n | tail -1 | \
	  awk '{printf "%.2f\n", $1}' > "$RESFILE" &
	local PID=$!
	echo -n -e "* ${TNAMES[13]}:\t\t"
	animate 13 && return 0 || return 99
}

rungeekbench() {
	GB_STATUS="failed"
	GB_ERROR=""
	GB_URL=""
	GB_LOG="$WORKDIR/geekbench_${CDATE}.log"

	geekbench --cpu > "$GB_LOG" 2>&1 &
	local PID=$!
	echo -n -e "* geekbench CPU benchmark:\t\t"
	local s='-+' ; local i=0
	while kill -0 "$PID" &>/dev/null
	do i=$(( (i+1) %2 ))
		printf "\b${s:$i:1}"
		sleep 1
	done

	wait "$PID"
	local gb_rc=$?
	if (( gb_rc != 0 )); then
		printf "\b failed\n"
		GB_ERROR="Geekbench failed with exit code $gb_rc"
		return 0
	fi

	printf "\b done\n"
	GB_STATUS="completed"
	GB_URL=$(grep -oE 'https://browser\.geekbench\.com/v6/cpu/[0-9]+' "$GB_LOG" | head -n1)
	if [[ -n "$GB_URL" ]]; then
		GB_STATUS="uploaded"
	else
		GB_ERROR="Geekbench completed, but no result URL was found"
	fi
	return 0
}

