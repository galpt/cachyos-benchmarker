# update if we find them below

# Read the ops name into its own variable: TMP is reused later as the
# configure prefix, so it must keep its /tmp value.
if [ -f "/sys/kernel/sched_ext/root/ops" ]; then
	SCX_OPS=$(cat "/sys/kernel/sched_ext/root/ops")
	if [ -n "$SCX_OPS" ]; then
		SCX=$(awk -F'[[:digit:]]' '{print $1}' "/sys/kernel/sched_ext/root/ops" | sed -rn 's/^(.*)_$/\1/p')
		SCX_VERSION=$(sed -rn 's/^[^0-9]*([0-9]+(\.[0-9]+)+).*$/\1/p' "/sys/kernel/sched_ext/root/ops")
		[[ -z "$SCX" ]] && SCX="$SCX_OPS"
	fi
fi

VERSION=$(pacman -Qi cachyos-benchmarker 2>/dev/null | grep "Version         :" || true)
# allow more open files, needed by perf bench msg
ulimit -n 4096

# I leave this for reference
#CPUFREQ=$(cpupower frequency-info -l | grep -v "analyzing" | awk '{print $2 / 1000000}')
#CPUGOV=$(cpupower frequency-info -o | grep -m1 "^CPU" | awk -F' -  ' '{ print $3 }')
#CPUMHZ=$(lscpu -e=maxmhz | tail -n1)
#CPUGHZ=$(echo "scale=1; ${CPUMHZ%%,*} / 1000" | bc)
#CPUL3C=$(lscpu -C=name,all-size | awk '/L3/{print $2}')

# terminal effects
TB=$(tput bold)
TN=$(tput sgr0)
FARBE1="`printf '\033[0;91m'`"
FARBE2="`printf '\033[4;37m'`"
FARBE3="`printf '\033[0;33m'`"

CLEANUP=false
WORKDIR=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		-c|--cleanup)
			CLEANUP=true
			shift
			;;
		-h|--help)
			intro
			exit 0
			;;
		-*)
			echo "Unknown option: $1"
			intro
			exit 1
			;;
		*)
			if [[ -z "$WORKDIR" ]]; then
				WORKDIR="$1"
			else
				echo "Too many arguments. Expected: [options] <workdir>"
				exit 1
			fi
			shift
			;;
	esac
done

if [[ -z "$WORKDIR" ]]; then
	intro
	exit 0
fi

# check system memory
[[ $RAMSIZE -lt 3500 ]] && echo "Your computer must have at least 3500 MB of RAM! Aborting." && exit 2

[[ "${WORKDIR:0:1}" != "/" ]] && WORKDIR="$PWD/$WORKDIR"
if [[ ! -d "$WORKDIR" ]] ; then
	read -p "The specified directory ${TB}$WORKDIR${TN} does not exist. Create it (y/N)? " DCHOICE
	[[ $DCHOICE = "y" || $DCHOICE = "Y" ]] && mkdir -p "$WORKDIR" || exit 4
fi
# The workdir is the results area: the run log, charts, exports, and per-run
# temporary files live at its root. Downloaded archives and extracted trees
# live in a sibling assets/ directory shared by sibling workdirs.
ASSETDIR="$(dirname "$WORKDIR")/assets"
SCRIPT_ASSETS="$SCRIPTDIR/assets"

# check files function
checkfiles() {
	echo -e "\n${TB}Checking, downloading and preparing test files...${TN}"
	mkdir -p "$ASSETDIR"

	# Markers are the preparation contract: a marker without its output means
	# the tree was removed by hand, and failing at run time wastes the whole
	# run.
	local PRE_MARKERS=( ".video.done" ".ffmpeg-${FFMPEGVER}.done" ".namd-${NAMDVER}.done" \
	    ".blend.done" ".firefox.done" ".linux-${KERNVER}.done" ".yc-${YCRUNCHER_VER}.done" )
	local PRE_OUTPUTS=( "bosphorus_hd.y4m" "ffmpeg-$FFMPEGVER" "namd" "bmw_cpu_mod.blend" \
	    "firefox102.tar" "linux-$KERNVER" "y-cruncher v$YCRUNCHER_VER-static" )
	for ((i=0; i<${#PRE_MARKERS[@]}; i++)); do
		if [[ -f "$ASSETDIR/${PRE_MARKERS[$i]}" && ! -e "$ASSETDIR/${PRE_OUTPUTS[$i]}" ]]; then
			echo "ERROR: $ASSETDIR/${PRE_MARKERS[$i]} exists but $ASSETDIR/${PRE_OUTPUTS[$i]} is missing; remove the marker or restore the asset"
			exit 4
		fi
	done

	# stress-ng jobfile
	cat > "$WORKDIR/stressC" <<- EOF
	run sequential 0
	no-rand-seed
	temp-path /tmp
	timeout 0
	matrix CPUCORES
	matrix-method prod
	matrix-size 256
	EOF
	echo "matrix-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	sparsematrix CPUCORES
	sparsematrix-method hash
	sparsematrix-items 15000
	EOF
	echo "sparsematrix-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	shm CPUCORES
	shm-bytes 16m
	EOF
	echo "shm-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	fork CPUCORES
	fork-max 8
	EOF
	echo "fork-ops $((24000 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	cpu CPUCORES
	cpu-method cdouble
	EOF
	echo "cpu-ops $((4800 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	bsearch CPUCORES
	EOF
	echo "bsearch-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<-EOF
	stream CPUCORES
	EOF
	echo "stream-ops $((4800 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	list CPUCORES
	EOF
	echo "list-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	qsort CPUCORES
	qsort-size 65536
	EOF
	echo "qsort-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"
	cat >> "$WORKDIR/stressC" <<- EOF
	memfd CPUCORES
	memfd-bytes 128m
	memfd-fds 128
	EOF
	echo "memfd-ops $((2400 / ${CPUCORES}))" >> "$WORKDIR/stressC"

	sed -i "s/CPUCORES/$CPUCORES/g" "$WORKDIR/stressC"

	# An asset is 'prepared' only when its completion marker exists. The
	# directory itself is not a reliable signal: mkdir() succeeds before
	# extraction, and a zero-byte archive passes a -f gate. The marker is
	# written only after every preparation step returned success, so the gate
	# stays idempotent across runs and across failures.
	if [[ ! -f "$ASSETDIR/.video.done" ]]; then
		rm -f "$ASSETDIR/bosphorus_hd.y4m"
		ensure_archive "$ASSETDIR/bosphorus_hd.7z" "video" \
		  "http://ultravideo.cs.tut.fi/video/Bosphorus_1920x1080_120fps_420_8bit_YUV_Y4M.7z" \
		  "$VIDEO_SHA" 7z t
		echo "--> Unzipping video..."
		cd "$ASSETDIR" || exit 4
		7z e bosphorus_hd.7z -o./ &>/dev/null || { echo "ERROR: 7z e bosphorus_hd.7z -o./ failed"; exit 4; }
		mv Bosphorus_1920x1080_120fps_420_8bit_YUV.y4m bosphorus_hd.y4m || \
		  { echo "ERROR: mv Bosphorus_1920x1080_120fps_420_8bit_YUV.y4m bosphorus_hd.y4m failed"; exit 4; }
		: > "$ASSETDIR/.video.done"
	fi

	if [[ ! -f "$ASSETDIR/.ffmpeg-${FFMPEGVER}.done" ]]; then
		rm -rf "$ASSETDIR/ffmpeg-$FFMPEGVER"
		ensure_archive "$ASSETDIR/ffmpeg.tar.xz" "ffmpeg" \
		  "https://ffmpeg.org/releases/ffmpeg-$FFMPEGVER.tar.xz" \
		  "$FFMPEG_SHA" tar -tf
		echo "--> Preparing ffmpeg..."
		cd "$ASSETDIR" || exit 4
		tar -xf ffmpeg.tar.xz || { echo "ERROR: tar -xf ffmpeg.tar.xz failed"; exit 4; }
		: > "$ASSETDIR/.ffmpeg-${FFMPEGVER}.done"
	fi

	if [[ ! -f "$ASSETDIR/.namd-${NAMDVER}.done" ]]; then
		# The vendored archives live inside $ASSETDIR/namd when the workdir
		# sits in the repository, so only the extracted trees are removed
		# here, never the directory itself.
		rm -rf "$ASSETDIR/namd/NAMD_${NAMDVER}_Linux-x86_64-multicore" "$ASSETDIR/namd/apoa1"
		# Prefer the vendored archive when present: it is committed content
		# pinned at use, so the download path is exercised only by installs
		# that lack the repository assets.
		local NAMD_SRC="$SCRIPT_ASSETS/namd/NAMD_${NAMDVER}_Linux-x86_64-multicore.tar.gz"
		local NAMDEX_SRC="$SCRIPT_ASSETS/namd/apoa1.tar.gz"
		if [[ -f "$NAMD_SRC" ]]; then
			echo "$NAMD_SHA  $NAMD_SRC" | sha256sum -c - &>/dev/null || \
			  { echo "ERROR: Vendored NAMD archive failed its SHA-256 checksum"; exit 4; }
		else
			NAMD_SRC="$ASSETDIR/namd.tar.gz"
			ensure_archive "$NAMD_SRC" "NAMD" "$NAMD_URL" "$NAMD_SHA" tar -tf
		fi
		if [[ -f "$NAMDEX_SRC" ]]; then
			echo "$NAMDEX_SHA  $NAMDEX_SRC" | sha256sum -c - &>/dev/null || \
			  { echo "ERROR: Vendored NAMD example archive failed its SHA-256 checksum"; exit 4; }
		else
			NAMDEX_SRC="$ASSETDIR/namd-example.tar.gz"
			ensure_archive "$NAMDEX_SRC" "NAMD example" "$NAMDEX_URL" "$NAMDEX_SHA" tar -tf
		fi
		echo "--> Preparing NAMD..."
		cd "$ASSETDIR" || exit 4
		mkdir -p namd
		tar -C namd -xf "$NAMD_SRC" || { echo "ERROR: tar -C namd -xf $NAMD_SRC failed"; exit 4; }
		tar -C namd -xf "$NAMDEX_SRC" || { echo "ERROR: tar -C namd -xf $NAMDEX_SRC failed"; exit 4; }
		sed -i 's/\/usr//;s/500/400/' namd/apoa1/apoa1.namd || \
		  { echo "ERROR: sed -i namd/apoa1/apoa1.namd failed"; exit 4; }
		: > "$ASSETDIR/.namd-${NAMDVER}.done"
	fi

	if [[ ! -f "$ASSETDIR/.firefox.done" ]]; then
		rm -f "$ASSETDIR/firefox102.tar"
		ensure_archive "$ASSETDIR/firefox102.tar.xz" "Firefox" \
		  "http://ftp.mozilla.org/pub/firefox/releases/102.9.0esr/source/firefox-102.9.0esr.source.tar.xz" \
		  "$FIREFOX_SHA" xz -t
		echo "--> Unzipping Firefox tarball..."
		xz -d -k -q -f "$ASSETDIR/firefox102.tar.xz" || \
		  { echo "ERROR: xz -d -k -q -f $ASSETDIR/firefox102.tar.xz failed"; exit 4; }
		: > "$ASSETDIR/.firefox.done"
	fi

	if [[ ! -f "$ASSETDIR/.linux-${KERNVER}.done" ]]; then
		rm -rf "$ASSETDIR/linux-$KERNVER"
		ensure_archive "$ASSETDIR/linux-$KERNVER.tar.xz" "Linux kernel" \
		  "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$KERNVER.tar.xz" \
		  "$KERNEL_SHA" tar -tf
		echo "--> Uncompressing kernel source..."
		cd "$ASSETDIR" || exit 4
		tar -xf linux-$KERNVER.tar.xz || { echo "ERROR: tar -xf linux-$KERNVER.tar.xz failed"; exit 4; }
		: > "$ASSETDIR/.linux-${KERNVER}.done"
	fi

	if [[ ! -f "$ASSETDIR/.yc-${YCRUNCHER_VER}.done" ]]; then
		rm -rf "$ASSETDIR/y-cruncher v$YCRUNCHER_VER-static"
		ensure_archive "$ASSETDIR/y-cruncher.tar.xz" "y-cruncher" \
		  "https://github.com/Mysticial/y-cruncher/releases/download/v$YCRUNCHER_VER/y-cruncher.v$YCRUNCHER_VER-static.tar.xz" \
		  "$YC_SHA" tar -tf
		echo "--> Uncompressing y-cruncher..."
		cd "$ASSETDIR" || exit 4
		tar -xf y-cruncher.tar.xz || { echo "ERROR: tar -xf y-cruncher.tar.xz failed"; exit 4; }
		: > "$ASSETDIR/.yc-${YCRUNCHER_VER}.done"
	fi

	echo -e "\n${TB}Preparing kernel source...${TN}"
	cd "$ASSETDIR/linux-$KERNVER" || exit 4
	make -s distclean && make -s defconfig || \
	  { echo "ERROR: make -s distclean && make -s defconfig failed"; exit 4; }

	echo -e "\n${TB}Preparing ffmpeg source...${TN}"
	cd "$ASSETDIR/ffmpeg-$FFMPEGVER" || exit 4
	# ffbuild/config.mak only exists after configure has run, so on a fresh
	# tree make distclean fails before the first configure; a failing clean
	# is only a real error once the tree holds generated files.
	if ! make -s distclean &>/dev/null && [[ -f ffbuild/config.mak ]]; then
		echo "ERROR: make -s distclean failed"
		exit 4
	fi
	if ! ./configure --prefix=$TMP --disable-debug --enable-static \
	    --enable-gpl --enable-version3 --disable-ffplay --disable-ffprobe \
	    --disable-programs --disable-doc --disable-network --disable-protocols \
	    --disable-filters --disable-iconv --enable-libdrm --disable-stripping \
	    --disable-autodetect --cpu=native &>/dev/null; then
		echo "ERROR: ./configure failed; re-running without output suppression:"
		./configure --prefix=$TMP --disable-debug --enable-static \
		    --enable-gpl --enable-version3 --disable-ffplay --disable-ffprobe \
		    --disable-programs --disable-doc --disable-network --disable-protocols \
		    --disable-filters --disable-iconv --enable-libdrm --disable-stripping \
		    --disable-autodetect --cpu=native
		exit 4
	fi
}

checksys() {
	# ask user for dropping page cache
	echo -e "\n"
	read -p "Do you want to drop page cache now? Root privileges needed! (y/N) " DCHOICE
	[[ $DCHOICE = "y" || $DCHOICE = "Y" ]] && sync && su -c "echo 1 > /proc/sys/vm/drop_caches"

	LOCKFILE=$(mktemp "$WORKDIR/benchie.XXXX")

	read -p "Please enter a name for this run, or leave empty for default: " NCHOICE
	[[ -z $NCHOICE ]] && NCHOICE="$USER@$HOSTNAME-${LOCKFILE#*benchie.}"
	# results will be written to this file
	LOGFILE="$WORKDIR/benchie_${NCHOICE}_${CDATE}.log"
	# The log is created with O_EXCL semantics: a pre-existing symlink would
	# redirect the append writes outside the results tree, and the exclusive
	# create prevents a file planted between the check and the first write
	# from entering scoring.
	[[ -L "$LOGFILE" ]] && { echo "ERROR: $LOGFILE is a symlink, refusing to write through it"; exit 4; }
	rm -f "$LOGFILE"
	set -o noclobber
	: > "$LOGFILE" || { echo "ERROR: cannot create $LOGFILE"; set +o noclobber; exit 4; }
	set +o noclobber

	# traps (ctrl-c)
	trap killproc INT
	trap exitproc EXIT
}

header() {
	echo -e "\n${TB}Starting...${TN}\n" ; sync ; sleep 2

	echo "Kernel: $(uname -r)"
	echo "Sched-Ext: $SCX $SCX_VERSION"
	echo ""

	echo -e "__________________________________________________"
	echo -e "=====${TB}__${TN}==${TB}__${TN} ===========================${TB}_____${TN} ====="
	echo -e "====${TB}|  \/  |${TN}==== MINI BENCHMARKER ====${TB}| ___ ))${TN}===="
	echo -e "====${TB}| |\/| |${TN}======= by torvic9 =======${TB}| ___ \\${TN}====="
	echo -e "====${TB}|_|${TN}==${TB}|_|${TN}=========  $VER  =========${TB}|_____//${TN}===="
	echo -e "==================================================\n"
}

# Run a benchmark and map its failure to the contract codes: a
# prepare-class failure (4) propagates unchanged; anything else is a
# benchmark failure (8). The sleep preserves the pre-existing pacing.
run_or_exit() {
	"$@"
	local rc=$?
	sleep 2
	if (( rc == 4 )); then
		exit 4
	fi
	if (( rc != 0 )); then
		exit 8
	fi
}

# run
NRTESTS=14
declare -a WEIGHTS=(0.9 0.9 0.85 0.85 0.85 0.85 0.8 0.95 0.95 1 0.95 1 0.85 0.9)
checkfiles || exit $?
# A checksys abort is a prepare-class failure (exit 4, e.g. the run log could
# not be created) and must not be flattened to the benchmark code; header only
# echoes, so a failure there is mapped to 8.
checksys || exit $?
header || exit 8
run_or_exit runstress
run_or_exit runyc
run_or_exit runperf_sch
run_or_exit runperf_mem
run_or_exit runnamd
run_or_exit runprime
run_or_exit runargon
run_or_exit runffm
run_or_exit runxz
run_or_exit runkern
run_or_exit runblend
run_or_exit runx265
run_or_exit runschbench
runrps
sleep 1
run_or_exit runcyclictest

# time and score calculations, print and log final results
# Only numeric results may enter the scoring arithmetic. A result line that
# does not parse as a float is a failed run, not a number; interpolating it
# unquoted would corrupt the geometric mean and be evaluated by the shell.
# Failed runs are counted, excluded, and recorded in the log so the omission
# is visible to the reader.
FAILED_TESTS=0
FAILED_NAMES=()
declare -a VALID_W=()
declare -a VALID_V=()
for ((i=0; i<${NRTESTS}; i++)) ; do
	# The test is matched by its name in TNAMES, not by its position in the
	# log; the last occurrence of the name wins.
	v=$(awk -F': ' -v n="${TNAMES[$i]}" '$1==n {v=$2} END{print v}' "$LOGFILE")
	if [[ $v =~ ^[+-]?[0-9]+(\.[0-9]+)?$ ]]; then
		VALID_W+=("${WEIGHTS[$i]}")
		VALID_V+=("$v")
	else
		FAILED_TESTS=$((FAILED_TESTS + 1))
		FAILED_NAMES+=("${TNAMES[$i]}")
	fi
done

if (( FAILED_TESTS > 0 )); then
	FAILED_MSG="*** ${FAILED_TESTS} of ${NRTESTS} benchmarks have no valid result; excluded from scoring: ${FAILED_NAMES[*]} ***"
	echo "$FAILED_MSG"
	echo -e "$FAILED_MSG" >> "$LOGFILE"
fi

if (( FAILED_TESTS == NRTESTS )); then
	echo "ERROR: no benchmark produced a valid result; cannot compute a score"
	echo -e "ERROR: no benchmark produced a valid result; cannot compute a score" >> "$LOGFILE"
	exit 10
fi

# Weights are keyed to the test identity, not to the log position: y-cruncher
# runs second but is the eleventh entry in TNAMES.
read TOTTIME SCORE <<< "$(python3 - "$COEFF" "${#VALID_V[@]}" "${VALID_W[@]}" "${VALID_V[@]}" <<'PYEOF'
import sys

coeff = float(sys.argv[1])
m = int(sys.argv[2])
weights = [float(x) for x in sys.argv[3:3 + m]]
values = [float(x) for x in sys.argv[3 + m:3 + 2 * m]]

# The geometric mean collapses on a zero factor, so a measured zero is
# floored for the score terms; the raw value still counts into the total.
total = round(sum(values), 2)
product = 1.0
for value, weight in zip(values, weights):
	if value == 0.0:
		value = 0.01
	product *= value * coeff * weight
score = round(product ** (1.0 / m), 2)
print(total, score)
PYEOF
)"

echo "--------------------------------------------------"
echo "Total time in seconds:"
echo "--------------------------------------------------"
echo "  ${TB}$TOTTIME${TN}" ; echo -e "\nTotal time (s): $TOTTIME" >> "$LOGFILE"
echo "--------------------------------------------------"
echo -n "Total score, lower is better" ; echo " [multi = $COEFF]:"
echo "--------------------------------------------------"
echo "  ${TB}$SCORE${TN}" ; echo "Total score: $SCORE" >> "$LOGFILE"
echo "=================================================="

# geekbench (score-based, not included in timed scoring)
if command -v geekbench &>/dev/null; then
	rungeekbench
	echo "--------------------------------------------------"
	echo "Geekbench CPU Result:"
	echo "--------------------------------------------------"
	if [[ "$GB_STATUS" == "uploaded" ]]; then
		echo "  Result URL: $GB_URL"
		echo "  Log: $GB_LOG"
		echo -e "geekbench status: uploaded" >> "$LOGFILE"
		echo -e "geekbench url: $GB_URL" >> "$LOGFILE"
		echo -e "geekbench log: $GB_LOG" >> "$LOGFILE"
	else
		echo "  ${FARBE1}${GB_ERROR:-Geekbench did not provide a result URL}${TN}"
		[[ -n "$GB_LOG" ]] && echo "  Log: $GB_LOG"
		echo -e "geekbench status: ${GB_STATUS:-failed}" >> "$LOGFILE"
		[[ -n "$GB_ERROR" ]] && echo -e "geekbench error: $GB_ERROR" >> "$LOGFILE"
		[[ -n "$GB_LOG" ]] && echo -e "geekbench log: $GB_LOG" >> "$LOGFILE"
	fi
	echo "=================================================="
fi

# Absent metrics are omitted, not zeroed: publishing 0 would read as a real measurement.
if [[ -s "$WORKDIR/runrps" ]]; then
	echo -e "schbench avg rps: $(cat "$WORKDIR/runrps")" >> "$LOGFILE"
fi
echo -e "\nName: ${NCHOICE}" >> "$LOGFILE"
echo -e "Date: ${CDATE}" >> "$LOGFILE"
echo -e "\n$SYSINFO" >> "$LOGFILE"
echo -e "\nSCX Scheduler: ${SCX}" >> "$LOGFILE"
echo -e "\nSCX Version: ${SCX_VERSION}" >> "$LOGFILE"
echo -e "\n ${VERSION}" >> "$LOGFILE"

cd "$WORKDIR" || exit 4
if [[ -f "$SCRIPTDIR/benchmark_scraper.py" ]]; then
	python "$SCRIPTDIR/benchmark_scraper.py"
else
	python /usr/bin/benchmark_scraper.py
fi
